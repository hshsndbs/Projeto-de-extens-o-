rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Rede de segurança global: nega tudo por padrão
    match /{document=**} {
      allow read, write: if false;
    }

    // =========================================================================
    // Funções auxiliares reutilizáveis
    // =========================================================================
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    // Validação do documento Sala
    function isValidSala(data) {
      return data.keys().hasAll(['status', 'atualizadoEm'])
        && data.keys().hasOnly(['status', 'atualizadoEm'])
        && data.status is string
        && (data.status == 'aguardando' || data.status == 'iniciada')
        && data.atualizadoEm is timestamp;
    }

    // Validação do documento Jogador
    function isValidJogador(data) {
      return data.keys().hasAll(['uid', 'nome', 'pronto', 'entrouEm', 'ultimoSinal'])
        && data.keys().hasOnly(['uid', 'nome', 'pronto', 'entrouEm', 'ultimoSinal', 'bot', 'avisou'])
        && data.uid is string
        && data.uid.size() > 0 && data.uid.size() <= 128
        && data.nome is string
        && data.nome.size() >= 1 && data.nome.size() <= 16
        && data.pronto is bool
        && data.entrouEm is timestamp
        && data.ultimoSinal is timestamp
        && (!('bot' in data) || data.bot is bool)
        && (!('avisou' in data) || data.avisou is bool);
    }

    // Validação do documento Mensagem
    function isValidMensagem(data) {
      return data.keys().hasAll(['uid', 'tipo', 'autor', 'texto', 'hora'])
        && data.keys().hasOnly(['uid', 'tipo', 'autor', 'texto', 'hora'])
        && data.uid is string
        && data.uid.size() > 0 && data.uid.size() <= 128
        && data.tipo is string
        && (data.tipo == 'usuario' || data.tipo == 'sistema')
        && data.autor is string
        && data.autor.size() >= 1 && data.autor.size() <= 16
        && data.texto is string
        && data.texto.size() >= 1 && data.texto.size() <= 200
        && data.hora is timestamp;
    }

    // =========================================================================
    // Teste de conectividade inicial
    // =========================================================================
    match /test/connection {
      allow get: if isVerifiedUser();
      allow list, write: if false;
    }

    // =========================================================================
    // Coleção de Salas e subcoleções de Jogadores e Mensagens
    // =========================================================================
    match /salas/{salaId} {
      allow get: if isVerifiedUser() && isValidId(salaId);
      allow list: if false;

      allow create: if isVerifiedUser()
        && isValidId(salaId)
        && isValidSala(incoming())
        && incoming().status == 'aguardando'
        && incoming().atualizadoEm == request.time;

      allow update: if isVerifiedUser()
        && isValidId(salaId)
        && isValidSala(incoming())
        && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'atualizadoEm'])
        && incoming().atualizadoEm == request.time
        && (
          // Iniciar partida (aguardando -> iniciada)
          (existing().status == 'aguardando' && incoming().status == 'iniciada')
          ||
          // Voltar para a sala ou reiniciar sala vazia (-> aguardando)
          (incoming().status == 'aguardando')
        );

      allow delete: if false;

      match /jogadores/{jogadorId} {
        allow get: if isVerifiedUser() && isValidId(salaId) && isValidId(jogadorId);
        allow list: if isVerifiedUser() && isValidId(salaId);

        allow create: if isVerifiedUser()
          && isValidId(salaId)
          && isValidId(jogadorId)
          && isValidJogador(incoming())
          && incoming().uid == request.auth.uid
          && incoming().pronto == false
          && incoming().entrouEm == request.time
          && incoming().ultimoSinal == request.time;

        allow update: if isVerifiedUser()
          && isValidId(salaId)
          && isValidId(jogadorId)
          && isValidJogador(incoming())
          && incoming().uid == existing().uid
          && incoming().nome == existing().nome
          && incoming().entrouEm == existing().entrouEm
          && (
            (!('bot' in incoming()) && !('bot' in existing()))
            || ('bot' in incoming() && 'bot' in existing() && incoming().bot == existing().bot)
          )
          && (
            // Ação 1: O próprio jogador alterna "pronto", ou um bot marca "pronto" e "avisou: true"
            (
              existing().uid == request.auth.uid
              && incoming().diff(existing()).affectedKeys().hasOnly(['pronto', 'ultimoSinal'])
              && incoming().ultimoSinal == request.time
            )
            ||
            (
              ('bot' in existing() && existing().bot == true)
              && incoming().diff(existing()).affectedKeys().hasOnly(['pronto', 'ultimoSinal', 'avisou'])
              && incoming().ultimoSinal == request.time
              && (!('avisou' in incoming()) || incoming().avisou == true)
            )
            ||
            // Ação 2: Reset atômico em lote ao clicar em "Voltar para a sala"
            (
              incoming().pronto == false
              && incoming().diff(existing()).affectedKeys().hasOnly(['pronto'])
              && get(/databases/$(database)/documents/salas/$(salaId)).data.status == 'iniciada'
              && getAfter(/databases/$(database)/documents/salas/$(salaId)).data.status == 'aguardando'
            )
          );

        allow delete: if isVerifiedUser()
          && isValidId(salaId)
          && isValidId(jogadorId)
          && (
            existing().uid == request.auth.uid
            || ('bot' in existing() && existing().bot == true)
          );
      }

      match /mensagens/{mensagemId} {
        allow get: if isVerifiedUser() && isValidId(salaId) && isValidId(mensagemId);
        allow list: if isVerifiedUser() && isValidId(salaId);

        allow create: if isVerifiedUser()
          && isValidId(salaId)
          && isValidId(mensagemId)
          && isValidMensagem(incoming())
          && incoming().uid == request.auth.uid
          && incoming().hora == request.time;

        allow update: if false;
        allow delete: if isVerifiedUser()
          && isValidId(salaId)
          && isValidId(mensagemId);
      }
    }
  }
}
